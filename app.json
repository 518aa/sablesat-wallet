{
  "expo": {
    "name": "SableSat",
    "slug": "sablesat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sablesat-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/sablesat-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bitnest.wallet",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": true,
        "ITSEncryptionExportComplianceCode": "REPLACE_WITH_YOUR_EXPORT_COMPLIANCE_CODE",
        "NSCameraUsageDescription": "SableSat 需要相机扫描多签 PSBT 与协同方公钥 QR",
        "NSFaceIDUsageDescription": "SableSat 使用 Face ID 保护您的助记词与签名操作",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsArbitraryLoadsInWebContent": false,
          "NSAllowsLocalNetworking": false
        }
      }
    },
    "android": {
      "package": "com.bitnest.wallet",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/sablesat-icon.png",
        "backgroundColor": "#07090D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC"
      ],
      "allowBackup": false
    },
    "extra": {
      "alipayOrderEndpoint": "$EXPO_PUBLIC_ALIPAY_ORDER_ENDPOINT",
      "btcNetwork": "mainnet"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-camera",
      "expo-local-authentication",
      "react-native-quick-crypto",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": false
          }
        }
      ]
    ]
  }
}
