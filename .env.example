# 支付宝下单后端（未配置时自动进入演示模式）
EXPO_PUBLIC_ALIPAY_ORDER_ENDPOINT=https://your-api.example.com/payments/alipay/order

# ── 以下仅本地/CI 构建脚本使用，不进 App bundle ──
# App Store Connect API（scripts/asc_api.py）
# ASC_KEY_PATH=/secure/path/AuthKey_XXXXXXXXXX.p8
# ASC_KEY_ID=XXXXXXXXXX
# ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ASC_TEAM_ID=XXXXXXXXXX

# Android 上传签名（也可放 ~/.gradle/gradle.properties）
# SABLESAT_UPLOAD_STORE_FILE=/secure/path/upload.keystore
# SABLESAT_UPLOAD_STORE_PASSWORD=
# SABLESAT_UPLOAD_KEY_ALIAS=upload
# SABLESAT_UPLOAD_KEY_PASSWORD=
